# ============================================================
# Call of Duty League Discord Bot - Environment Configuration
# ============================================================

# 1. Discord Bot Token
# Get this from: https://discord.com/developers/applications
# - Create "New Application" -> Go to "Bot" tab -> Click "Reset Token"
# - Scroll down to "Privileged Gateway Intents" and enable:
#   [x] MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. Google Gemini API Key (Recommended for high-accuracy vision)
# Get a free key at: https://aistudio.google.com/app/apikey
# It effortlessly reads in-game fonts, clan tags, K/D, damage, and scores.
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Default Extraction Engine
# Choices: 'gemini' (Recommended) or 'ocr' (local Tesseract fallback)
DEFAULT_ENGINE=gemini

# 4. SQLite database path for active series (use a persistent volume on hosted deployments)
SERIES_DB_PATH=cod_bot.db
