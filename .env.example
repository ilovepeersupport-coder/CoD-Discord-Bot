# ============================================================
# Call of Duty League Discord Bot - Environment Configuration
# ============================================================
# Copy this file to .env next to bot.py. Never commit .env.

# Discord bot token from the Developer Portal.
# https://discord.com/developers/applications -> Bot -> Reset Token
# This bot uses slash commands only. Leave privileged gateway intents OFF.
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API key. Required for the default, accurate scoreboard reader.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# gemini (default) or ocr. OCR needs the tesseract binary and is much less accurate.
DEFAULT_ENGINE=gemini

# Optional comma-separated model fallback order.
# gemini-3.5-flash is deprecated; use gemini-3.6-flash instead.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# SQLite file for active series. Relative paths are stored next to bot.py.
# In Docker this defaults to /data/cod_bot.db.
SERIES_DB_PATH=cod_bot.db

# Seconds a user must wait between screenshot uploads. Set 0 to disable.
EXTRACT_COOLDOWN_SECONDS=5

# Sync slash commands when the bot logs in. Set false on hosts that restart
# constantly after the commands are already registered.
SYNC_COMMANDS=true

# Optional server (guild) ID. When set, commands sync to that server immediately.
# Leave blank in production so commands sync globally for every server.
DISCORD_GUILD_ID=
